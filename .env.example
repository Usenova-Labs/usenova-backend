# BYOI Platform Environment Configuration Example
# Copy this file to .env and update with your values

# Control Plane
CONTROL_PLANE_PORT=8080
CONTROL_PLANE_HOST=localhost
# SQLite file persisting the agent registry (schema bootstrapped on startup)
CONTROL_PLANE_DB_PATH=data/control-plane.db
DATABASE_URL=postgresql://byoi:password@localhost:5432/byoi
REDIS_URL=redis://localhost:6379

# Stellar Network
STELLAR_NETWORK=testnet  # testnet or mainnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_DEFAULT_ASSET=XLM  # default asset for balance queries (XLM or USDC)
PAYMENT_ESCROW_CONTRACT_ID=

# CLI -> control plane connection (local development default)
# NOVA_* are preferred; USENOVA_* are kept as a fallback for existing setups.
NOVA_CONTROL_PLANE_URL=http://127.0.0.1:8080
USENOVA_CONTROL_PLANE_URL=http://127.0.0.1:8080

# Agent
AGENT_ID=
AGENT_SECRET=
CONTROL_PLANE_URL=https://api.byoi.dev

# Authentication
JWT_SECRET=your-secret-key-change-this
JWT_EXPIRY=24h

# Logging
LOG_LEVEL=info  # debug, info, warn, error
LOG_FORMAT=json  # json or text
