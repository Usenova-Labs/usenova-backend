# Usenova Agent Configuration Example
# Copy this file to .env and update with your values

# Required: Control Plane API endpoint
CONTROL_PLANE_URL=https://api.usenova.dev

# Required: Agent token for authentication
AGENT_TOKEN=your-agent-token-here

# Optional: Agent ID (will be generated if not provided)
# AGENT_ID=agent-12345

# Optional: Heartbeat interval (default: 30s)
# Can be specified as duration (30s, 1m, 2m30s) or seconds (30)
HEARTBEAT_INTERVAL=30s

# Optional: How often the agent asks the Control Plane for pending commands
# (default: 10s)
COMMAND_POLL_INTERVAL=10s
# Optional: Restart limits for failing services (default: 3 restarts per 10m
# window, 30s base backoff that doubles with every attempt, capped at 5m).
# RESTART_MAX_RESTARTS=3
# RESTART_WINDOW=10m
# RESTART_BACKOFF=30s

# Optional: Platform registration (Usenova fleet agents only). Leave
# PLATFORM_BOOTSTRAP_TOKEN unset for normal BYOI registration.
# PLATFORM_BOOTSTRAP_TOKEN=your-platform-bootstrap-token
# PLATFORM_OWNER_ID=fleet-1
# PLATFORM_LABELS=region=us-east,pool=alpha

# Optional: Enable debug logging
# DEBUG=1